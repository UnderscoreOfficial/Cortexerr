# .editorconfig
[*.cs]

# Naming rules
dotnet_naming_rule.constants_should_be_upper_snake.severity = error
dotnet_naming_rule.constants_should_be_upper_snake.symbols = constants
dotnet_naming_rule.constants_should_be_upper_snake.style = upper_snake_case

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_style.upper_snake_case.capitalization = all_upper
dotnet_naming_style.upper_snake_case.word_separator = _
